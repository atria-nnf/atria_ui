# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL (for auth callbacks)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email notifications (Resend) — https://resend.com/api-keys
# Contact form submissions are emailed to CONTACT_NOTIFICATION_EMAIL.
# EMAIL_FROM must be on a domain verified in Resend (falls back to onboarding@resend.dev for testing).
RESEND_API_KEY=re_your_api_key
CONTACT_NOTIFICATION_EMAIL=info@poliklinika-atria.hr
EMAIL_FROM=Poliklinika Atria <web@poliklinika-atria.hr>

# EasyBusy price list API (sidrene cijene) — key provided by the clinic
EASYBUSY_API_KEY=your_easybusy_api_key
